# API route snapshot from scripts/check-docs.sh (`collect_lenses_api_routes.py --output`)
build/

# Electron desktop shell (Phase 1)
desktop/node_modules/
desktop/test-results/
desktop/playwright-report/
desktop/blob-report/

# Machine-local lenses data (forge-lenses checkout)
.lenses-local/

# Versona / Ember session exports (local-only)
forge-logs/
ember-logs/

# Studio screenshot tours default to ../.workspace-screenshots/<repo>/studio-explore/ (outside repo).
# Legacy runs may still exist here until moved:
agents/workspaces/studio-explore/

# Local OpenAI-compat env (copy from scripts/lenses-openai-compat.env.example); never commit secrets
lenses-openai-compat.local.env

# Generated by scripts/bootstrap-local-fleet-dev.sh — bearer for local forge-fleet (never commit)
scripts/.local-fleet-bearer.env

# Built lenses handbook HTML is local-only; version reference PNG previews (Playwright) for parity.
lenses-docs/*
!lenses-docs/previews/
!lenses-docs/previews/**

# forge-autodoc tutorial output + dashboard sync (see build-fa-tutorials.sh)
lenses/tutorials/
lenses/fa-tutorials/
tutorial/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
