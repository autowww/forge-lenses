# Copy to <workspace>/.lenses-local/lenses-oidc.env (gitignored via .lenses-local/).
# Loaded at Lenses startup when variables are not already in the process environment.

# Public browser origin (required behind nginx / Firebase reverse proxy)
LENSES_PUBLIC_ORIGIN=https://leo.forgedc.net

# Google OAuth (Cloud Console → APIs & Services → Credentials)
LENSES_OIDC_ISSUER=https://accounts.google.com
LENSES_OIDC_CLIENT_ID=your-client-id.apps.googleusercontent.com
LENSES_OIDC_CLIENT_SECRET=your-client-secret
# Omit to auto-pick from LENSES_STICKERBOARD_PUBLIC_BASE (leo → /stickerboard/api/…):
# LENSES_OIDC_REDIRECT_PATH=/stickerboard/api/auth/oidc/callback
LENSES_OIDC_SCOPES=openid profile email

# Stickerboard guest links (production)
LENSES_STICKERBOARD_PUBLIC_BASE=https://leo.forgedc.net/stickerboard
LENSES_STICKERBOARD_PORT=0
