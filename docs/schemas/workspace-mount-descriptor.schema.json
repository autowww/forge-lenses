{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lenses.forgesdlc.com/schemas/workspace-mount-descriptor.schema.json",
  "title": "Workspace root mount descriptor",
  "x-lenses-stability": "stable",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "label"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["host_path", "packaged_fixture", "ephemeral_scratch"]
    },
    "label": {
      "type": "string",
      "maxLength": 200
    },
    "resolution_note": {
      "type": "string",
      "maxLength": 400,
      "description": "Explain why Studio chose this workspace root."
    }
  }
}
