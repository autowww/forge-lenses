{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lenses.forgesdlc.com/schemas/rbac-scope-set.schema.json",
  "title": "RBAC scope token collection",
  "x-lenses-stability": "experimental",
  "type": "object",
  "additionalProperties": false,
  "required": ["scopes"],
  "properties": {
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 96
      }
    },
    "actor": {
      "type": "string",
      "maxLength": 120,
      "description": "Optional human or principal label for auditors."
    }
  }
}
