# Optional overrides — `.env.development` / `.env.production` default the wizard on.
#
# Blueprints Wizard (route + sidebar): default **on**; set **false** to hide without removing server APIs.
# VITE_EXPERIMENTAL_BLUEPRINTS_WIZARD=false
#
# Call the Lenses Python API directly from the Vite dev server (bypasses proxy).
# Start Lenses with:  LENSES_ALLOW_DEV_CORS=1 python3 -m lenses
# VITE_LENSES_API_BASE=http://127.0.0.1:8080
