# Optional overrides — `.env.development` / `.env.production` default the wizard on.
#
# Blueprints Wizard (route + sidebar): default **on**; set **false** to hide without removing server APIs.
# VITE_EXPERIMENTAL_BLUEPRINTS_WIZARD=false
#
# Call the Lenses Python API directly from the Vite dev server (bypasses proxy).
# Start Lenses with:  LENSES_ALLOW_DEV_CORS=1 python3 -m lenses
# VITE_LENSES_API_BASE=http://127.0.0.1:8080
#
# Forge Lenses Stickerboard — guest share links (optional Vite fallback; server env is authoritative)
# Set on the **Lenses Python process** (required for production guest URLs):
#   LENSES_STICKERBOARD_PUBLIC_BASE=https://leo.forgedc.net/stickerboard
# Local dev listener (when not using public host only):
#   LENSES_STICKERBOARD_PORT=9999
# Optional Studio build-time hint (overridden by GET /api/sticker-board-share/config):
# VITE_STICKERBOARD_PUBLIC_BASE=https://leo.forgedc.net/stickerboard
#
# Google OIDC for Stickerboard guests (server — or copy docs/examples/lenses-oidc.env.example
# to <workspace>/.lenses-local/lenses-oidc.env):
#   LENSES_PUBLIC_ORIGIN=https://leo.forgedc.net
#   LENSES_OIDC_ISSUER=https://accounts.google.com
#   LENSES_OIDC_CLIENT_ID=…
#   LENSES_OIDC_CLIENT_SECRET=…
