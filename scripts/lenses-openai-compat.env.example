# Forge Lenses — OpenAI-compatible endpoint (LM Studio, Ollama OpenAI shim, ngrok tunnel, etc.)
# Copy to a GITIGNORED file (see forge-lenses/.gitignore) or paste `export` lines into your shell
# before `python3 -m lenses` / `./scripts/run-lenses.sh`. Do not commit real URLs or keys.

# Required for provider "openai_compatible" in Studio (LLM chat + SDLC copilot).
# Use the HTTP(S) origin ONLY — no trailing /v1 (the server appends /v1/chat/completions).
# Local Ollama is still a "custom URL": set the origin explicitly (default API port shown).
#   export LENSES_OPENAI_COMPAT_BASE_URL='http://127.0.0.1:11434'
# Other examples (placeholders):
#   export LENSES_OPENAI_COMPAT_BASE_URL='http://127.0.0.1:11435'
#   export LENSES_OPENAI_COMPAT_BASE_URL='https://YOUR_TUNNEL_HOST'

# Optional: Bearer token if your proxy requires it (Ollama often accepts any non-empty string).
# export LENSES_OPENAI_COMPAT_KEY='ollama'

# Optional: model id your server expects (Ollama tag). Granite 4 tiny example — confirm with `ollama list`.
# export LENSES_OPENAI_COMPAT_MODEL='ibm/granite4:tiny-h'

# After exporting, set Studio → Preferences → Active provider = openai_compatible (or rely on
# default saved in .lenses-local/llm-settings.json). SDLC copilot uses the same provider list.

# --- Native Ollama provider (separate from openai_compatible; uses /api/chat) ---
# Lenses does not default this; set explicitly before starting the server, e.g.:
#   export OLLAMA_BASE_URL='http://127.0.0.1:11434'
